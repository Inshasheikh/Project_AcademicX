# ==============================================================================
# Git Ignore Configuration - SIH 2026 / Academia Platform
# Protects sensitive credentials, environment files, databases, and dependencies
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secret Credentials (CRITICAL - DO NOT LEAK)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
!.env.example
!.env.template

# Secret Keys, Tokens, and Certificates
*.pem
*.key
*.cert
*.crt
secrets.json
service_account.json
credentials.json

# ------------------------------------------------------------------------------
# 2. Database Files (Contains user data, OTPs, hashes)
# ------------------------------------------------------------------------------
*.sqlite3
*.sqlite
*.db
*.db-journal
*.db-wal
*.db-shm

# ------------------------------------------------------------------------------
# 3. Python & Django
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyd
*.pyo

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Django media & static collections
/RedDot_FullStack_Code/backend/media/
static_collected/

# ------------------------------------------------------------------------------
# 4. Node.js & Vite Frontend
# ------------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/
.vite/
.output/

# Package manager lockfile backup/temp
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 5. Logs & System Runtime Files
# ------------------------------------------------------------------------------
*.log
logs/
*.pid
*.seed
*.pid.lock

# ------------------------------------------------------------------------------
# 6. Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

.idea/
.vscode/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 7. AI & Agent Temporary Metadata
# ------------------------------------------------------------------------------
.system_generated/
.gemini/
scratch/
