# ==============================================================================
# Academia / REDDOT Backend Environment Configuration Template
# Instructions: Copy this file to .env and replace the placeholder values.
# NEVER commit your real .env file with actual passwords to Git!
# ==============================================================================

# Gmail SMTP Settings for Academia OTP Authentication
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Enter your Gmail address here
EMAIL_HOST_USER=your_gmail_address@gmail.com

# Enter your 16-character Google App Password (Generated at: myaccount.google.com/apppasswords)
EMAIL_HOST_PASSWORD=your_app_password_without_spaces

# Sender Display Name
DEFAULT_FROM_NAME=Academia

# Fast2SMS Gateway API Key (Optional for Indian Mobile SMS OTP delivery)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Supabase Project Credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Django Secret Key (Optional - a default is used in dev)
DJANGO_SECRET_KEY=your_production_secret_key_here
